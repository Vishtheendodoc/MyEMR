# Local dev (no PostgreSQL required):
DATABASE_URL=sqlite:///./emr.db

# Production / Docker (use when PostgreSQL is running):
# DATABASE_URL=postgresql://emr:emr_secret@127.0.0.1:5432/endo_emr

JWT_SECRET=change-me-in-production-use-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true
CLINIC_NAME=Endo Clinic

# Optional: Twilio WhatsApp Business API for hands-free auto-reminders.
# Without these, the app opens WhatsApp click-to-chat (wa.me) links instead.
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
